{
	"name": "obsidian-bases-paginator",
	"version": "1.5.0",
	"description": "Adds a group-aware paginated table view to Obsidian Bases",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:host": "node .agents/skills/obsidian-host-test/scripts/verify-host.mjs",
		"test:watch": "vitest",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"fmt": "prettier --write \"{src,tests}/**/*.ts\" \".agents/skills/**/*.mjs\" \"*.{json,mts}\"",
		"fmt:check": "prettier --check \"{src,tests}/**/*.ts\" \".agents/skills/**/*.mjs\" \"*.{json,mts}\""
	},
	"keywords": [],
	"author": "sean2077",
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/jsdom": "^28.0.3",
		"@types/node": "^22.15.17",
		"esbuild": "0.28.1",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"jsdom": "^29.1.1",
		"obsidian": "^1.13.1",
		"prettier": "^3.9.5",
		"tslib": "^2.8.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^4.1.10"
	}
}
